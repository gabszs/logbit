{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"types": []
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"**/node_modules",
		"dist",
		"src/**/*.test.ts",
		"src/**/*.spec.ts"
	]
}
