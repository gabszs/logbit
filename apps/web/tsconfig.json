{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["vite/client", "bun-types"],
		"rootDirs": ["."],
		"baseUrl": ".",
		"paths": {
			"@/*": ["../server/src/*"],
			"@/web/*": ["./src/*"],
			"@/server/*": ["../server/src/*"]
		}
	},
	"exclude": ["node_modules", "**/node_modules", "dist"]
}
