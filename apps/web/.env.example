# Copy this file to .env.dev for development environment
# Copy this file to .env.prod for production environment

# The alchemy.run.ts file automatically loads the correct environment file based on the ALCHEMY_STAGE environment variable

# Public origin for API requests (no trailing slash)
# If you route your API Worker on the SAME custom domain (e.g. chat.example.com/api/*),
# set this to your site origin only: "https://chat.example.com"
# If you use a separate Workers.dev domain, set it to that host instead.
VITE_SERVER_URL="http://localhost:3000"
VITE_WEB_URL="http://localhost:3001"
VITE_LOGLOG_TRACE_WATERFALL_LIMIT="5000"

# Frontend OpenTelemetry. Endpoint is the OTLP HTTP base URL; the app sends
# traces to /v1/traces, metrics/Web Vitals to /v1/metrics, and logs to /v1/logs.
VITE_OTEL_ENABLED="true"
VITE_OTEL_EXPORTER_OTLP_ENDPOINT="http://192.168.1.3:4358"
VITE_OTEL_SERVICE_NAME="loglog-web"
VITE_OTEL_SERVICE_VERSION=""
VITE_OTEL_SAMPLE_RATIO="1"
VITE_OTEL_CONSOLE_ERROR_ENABLED="false"

CUSTOM_WEB_DOMAIN="example.com"
