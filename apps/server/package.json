{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"private": true,
	"dependencies": {
		"@ai-sdk/openai": "^3.0.51",
		"@better-auth/api-key": "^1.6.2",
		"@better-auth/redis-storage": "^1.5.5",
		"@bufbuild/protobuf": "^2.11.0",
		"@clickhouse/client": "^1.18.2",
		"@founderpath/kysely-clickhouse": "^1.7.0",
		"@hono-rate-limiter/redis": "^0.1.4",
		"@hono/otel": "^1.1.0",
		"@hono/zod-openapi": "^1.2.0",
		"@loglog/bun-instrumentation-pg": "workspace:*",
		"@loglog/bun-instrumentation-redis": "workspace:*",
		"@mastra/auth-better-auth": "^1.0.2",
		"@mastra/core": "^1.22.0",
		"@mastra/hono": "^1.4.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.213.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
		"@opentelemetry/host-metrics": "^0.38.3",
		"@opentelemetry/instrumentation-http": "^0.214.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.27.0",
		"@opentelemetry/instrumentation-undici": "^0.24.0",
		"@opentelemetry/resources": "^2.6.0",
		"@opentelemetry/sdk-metrics": "^2.6.0",
		"@opentelemetry/sdk-node": "^0.213.0",
		"@opentelemetry/semantic-conventions": "^1.40.0",
		"@orpc/server": "^1.13.2",
		"@scalar/hono-api-reference": "^0.9.30",
		"@scalar/openapi-to-markdown": "^0.4.7",
		"better-auth": "catalog:",
		"better-auth-cloudflare": "^0.2.9",
		"cloudflare": "^5.2.0",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"hono": "catalog:",
		"hono-problem-details": "^0.1.5",
		"hono-rate-limiter": "^0.5.3",
		"kysely": "^0.28.16",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.8",
		"resend": "^6.6.0",
		"ua-parser-js": "^2.0.7",
		"zod": "catalog:"
	},
	"scripts": {
		"build": "bun run typecheck",
		"typecheck": "tsc -b",
		"test": "bun test ./test/src",
		"test:auth": "bun test ./test/src/features/auth",
		"test:auth:delete-off": "bun test ./test/src/features/auth/delete-account-flag-off.integration.test.ts",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun --hot src/index.ts",
		"otel-dev": "bun --hot --preload src/otel.ts src/index.ts",
		"db:generate": "drizzle-kit generate --config=./drizzle.config.ts --name",
		"db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
		"db:studio:prod": "drizzle-kit studio --config=./drizzle.config.ts",
		"auth:generate": "bun ./node_modules/@better-auth/cli/dist/index.mjs generate --config src/lib/auth.ts --output src/db/models/authModels.ts -y",
		"proto:gen": "buf generate"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.3",
		"@bufbuild/buf": "^1.66.1",
		"@bufbuild/protoc-gen-es": "^2.11.0",
		"@types/node": "catalog:",
		"bun-types": "^1.3.11",
		"dotenv": "catalog:",
		"drizzle-kit": "^0.31.8",
		"kysely-codegen": "^0.20.0",
		"mastra": "^1.3.20",
		"openapi-types": "^12.1.3",
		"testcontainers": "^11.14.0",
		"tsdown": "catalog:",
		"tsx": "^4.21.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
