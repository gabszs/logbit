{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"private": true,
	"dependencies": {
		"@hono-rate-limiter/redis": "^0.1.4",
		"@hono/otel": "^1.1.0",
		"@hono/zod-openapi": "^1.2.0",
		"@opentelemetry/api": "^1.9.0",
		"@orpc/server": "^1.13.2",
		"@scalar/hono-api-reference": "^0.9.30",
		"@scalar/openapi-to-markdown": "^0.4.7",
		"better-auth": "1.4.10",
		"better-auth-cloudflare": "^0.2.9",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"hono-rate-limiter": "^0.5.3",
		"postgres": "^3.4.8",
		"resend": "^6.6.0",
		"ua-parser-js": "^2.0.7",
		"ulid": "^3.0.2",
		"zod": "catalog:"
	},
	"scripts": {
		"build": "bun run typecheck",
		"typecheck": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "PORT=4000 bun --hot src/index.ts",
		"db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
		"db:studio:prod": "drizzle-kit studio --config=./drizzle.config.ts",
		"auth:generate": "npx auth@latest generate --config src/lib/auth.ts --output src/db/models/authModels.ts -y"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.8",
		"tsx": "^4.21.0",
		"@types/node": "catalog:",
		"dotenv": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
